{
  "name": "what-are-my-agents-doing",
  "version": "0.3.0",
  "description": "What Are My Agents Doing? — see which of your Claude Code agents are working, at a glance, as a pixel-art office",
  "keywords": [
    "claude-code",
    "ai-agents",
    "agent-teams",
    "pixel-art",
    "dashboard",
    "visualization",
    "multi-agent"
  ],
  "author": {
    "name": "Yehwan Oh",
    "url": "https://github.com/dioKR"
  },
  "homepage": "https://dioKR.github.io/what-are-my-agents-doing/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dioKR/what-are-my-agents-doing.git"
  },
  "type": "module",
  "main": "desktop/main.mjs",
  "bin": {
    "wamad": "bin/wamad.mjs"
  },
  "files": [
    "bin/",
    "dist/web/",
    "dist/server/",
    "hooks/",
    "scripts/",
    "team/",
    "README.md",
    "README.ko.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "vite build && node server/index.ts",
    "server": "node server/index.ts",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test \"server/**/*.test.ts\" \"web/src/**/*.test.ts\" \"desktop/**/*.test.mjs\"",
    "hooks:install": "node scripts/install-claude-hooks.mjs",
    "hooks:uninstall": "node scripts/install-claude-hooks.mjs --uninstall",
    "team:install": "node scripts/install-team.mjs",
    "build:server": "esbuild server/app.ts server/index.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist/server --out-extension:.js=.mjs",
    "desktop": "npm run build && npm run build:server && electron .",
    "dist:desktop": "npm run build && npm run build:server && electron-builder --publish never",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run build:server",
    "test:e2e": "node --test \"e2e/**/*.test.mjs\"",
    "test:desktop": "node --test e2e/desktop.app.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "fsevents": false
  },
  "build": {
    "appId": "io.github.diokr.wamad",
    "productName": "What Are My Agents Doing",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "scripts/claude-hooks-lib.mjs",
      "package.json",
      "!desktop/**/*.test.mjs"
    ],
    "artifactName": "wamad-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "wamad-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "wamad-windows-setup.${ext}",
      "oneClick": true,
      "perMachine": false
    },
    "publish": {
      "provider": "github",
      "owner": "dioKR",
      "repo": "what-are-my-agents-doing",
      "releaseType": "release"
    }
  }
}
